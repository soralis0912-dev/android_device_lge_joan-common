#
# system props for joan
#

# Audio
audio.deep_buffer.media=true
audio.offload.video=false

# Bluetooth profiles
bluetooth.profile.asha.central.enabled?=true
bluetooth.profile.a2dp.source.enabled?=true
bluetooth.profile.avrcp.target.enabled?=true
bluetooth.profile.bas.client.enabled?=true
bluetooth.profile.gatt.enabled?=true
bluetooth.profile.hfp.ag.enabled?=true
bluetooth.profile.hid.device.enabled?=true
bluetooth.profile.hid.host.enabled?=true
bluetooth.profile.map.server.enabled?=true
bluetooth.profile.opp.enabled?=true
bluetooth.profile.pan.nap.enabled?=true
bluetooth.profile.pan.panu.enabled?=true
bluetooth.profile.pbap.server.enabled?=true
bluetooth.profile.ccp.server.enabled?=true
bluetooth.profile.vcp.controller.enabled?=true

# Bluetooth
bluetooth.hardware.power.idle_cur_ma=36
bluetooth.hardware.power.operating_voltage_mv=3700
bluetooth.hardware.power.rx_cur_ma=20
bluetooth.hardware.power.tx_cur_ma=3
persist.bluetooth.a2dp_offload.cap=sbc-aac-aptx-aptxhd-ldac
persist.bluetooth.a2dp_offload.disabled=true
ro.bluetooth.a2dp_offload.supported=false
vendor.bluetooth.soc=cherokee

# Charger
ro.charger.enable_suspend=true

# Dalvik
dalvik.vm.dex2oat64.enabled=true
ro.sys.fw.dex2oat_thread_count=8

# Device info card
# The banner in Settings has no way of working these out on its own: the
# processor name is not in any property the platform sets, and deriving the
# camera resolutions from camera2 would report the sensor arrays (16.3 / 13.1 /
# 5.0) rather than what the phone was sold as. s5k3m3 is the 16 MP main sensor,
# imx351 the 13 MP wide one and hi553 the 5 MP front one - see
# configs/camera/camera_config.xml.
persist.sys.device_camera_info_front=5
persist.sys.device_camera_info_rear=16,13
persist.sys.processor_info=Qualcomm_Snapdragon_835

# Display
debug.sf.enable_gl_backpressure=1
debug.sf.hw=1
debug.sf.latch_unsignaled=0
persist.debug.wfd.enable=0
persist.sys.wfd.virtual=0

# Fastbootd
ro.fastbootd.available=true

# Media
media.settings.xml=/vendor/etc/media_profiles_vendor.xml

# Perf
ro.vendor.qti.sys.fw.bg_apps_limit=48

# QC framework value-adds
ro.vendor.qti.va_aosp.support=1

# Radio
DEVICE_PROVISIONED=1
persist.sys.fflag.override.settings_network_and_internet_v2=true
ril.subscription.types=NV,RUIM
ro.telephony.default_network=10
telephony.lteOnCdmaDevice=1

# Time services
persist.delta_time.enable=true

# Voice assistant
ro.opa.eligible_device=true

# Do not block binder thread on incoming calls
ro.telephony.block_binder_thread_on_incoming_calls=false

# Disable MTE Async for system server
arm64.memtag.process.system_server=off
