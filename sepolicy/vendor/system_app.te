binder_call(system_app, {
    hal_power_default
    vold
    wificond
});

get_prop(system_app, {
    baseband_prop
    vendor_audio_prop
});

r_dir_file(system_app, {
    proc_pagetypeinfo
    proc_vmallocinfo
    sysfs_zram
});

# Two apps read here, and both run as system_app.
#
# parts/ reports what LG's charging driver knows about the cell - wear, cycles
# and the demo mode that parks the charge at half full - which AOSP has no
# field for. Read-only but for that one switch, which ueventd hands to system.
#
# QcomPdInfo reads the power delivery objects out of qualcomm's own driver,
# whose class sits under the PD PHY's platform device. Read-only throughout.
allow system_app sysfs_lge_power:dir r_dir_perms;
allow system_app sysfs_lge_power:file rw_file_perms;
allow system_app sysfs_usbpd:dir r_dir_perms;
allow system_app sysfs_usbpd:file rw_file_perms;

allow system_app sysfs_lge_fingerprint:dir r_dir_perms;
allow system_app sysfs_lge_fingerprint:file rw_file_perms;
allow system_app sysfs_lge_hifi_dac:file rw_file_perms;

dontaudit system_app {
    apex_service
    system_suspend_control_service
    system_suspend_control_internal_service
}:service_manager find;
